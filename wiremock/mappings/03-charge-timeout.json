{
  "priority": 3,
  "request": {
    "method": "POST",
    "urlPath": "/gateway/v1/charges",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.paymentMethodToken",
        "equalTo": "tok_timeout_9999"
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 7000,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "charge-redirect-success.json"
  }
}